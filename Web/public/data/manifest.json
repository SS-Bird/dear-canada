   "head": [
    {
     "incident_id": "incident_us_chc03_e17_0",
     "incident_type": "discrimination",
     "raw_text": "the people who live in Quebec want little to do with those of us on ships. They see us as bringing disease to their tow…"
    },
    {
     "incident_id": "incident_us_chc03_e17_1",
     "incident_type": "discrimination",
     "raw_text": "the newspapers are filled with editorials about the Irish lords shovelling their garbage into Canada"
    },
    {
     "incident_id": "incident_johanna_leary_chc04_e5_2",
     "incident_type": "discrimination",
     "raw_text": "He turned up his nose at me and walked away without a word."
    },
    {
     "incident_id": "incident_my_poor_countrymen_chc04_e5_3",
     "incident_type": "discrimination",
     "raw_text": "they had come to gawk and to chatter idly about my poor countrymen"
    },
    {
     "incident_id": "incident_johanna_leary_chc04_e18_4",
     "incident_type": "discrimination",
     "raw_text": "another girl, Claire, who clearly believes herself above me in station"
    },
    {
     "incident_id": "incident_the_irish_immigrants_chc04_e20_5",
     "incident_type": "discrimination",
     "raw_text": "the Irish immigrants at the fever sheds were selling the bread and oatmeal they were given...this proves they brought t…"
    },
    {
     "incident_id": "incident_johanna_leary_chc04_e21_6",
     "incident_type": "discrimination",
     "raw_text": "Mother says that Irish are lazy."
    },
    {
     "incident_id": "incident_johanna_leary_chc04_e21_7",
     "incident_type": "discrimination",
     "raw_text": "I will thank you to keep your heathen fairy stories to yourself... We do not abide such nonsense here."
    }
   ],
   "modified": "2026-10-03T21:09:47+00:00"
  },
